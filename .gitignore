# Ignore temporary files
*.tmp
*.log

# Ignore compiled binaries
*.o
*.out

# Ignore bedtools and bcftools temporary files
*.bed
*.vcf

# Ignore tes, output, ref, and tmp directories
/test/
/output/
/ref/
/tmp/
/stats/

# files with test in the name
*test*

# Allow tests directory and test data files (exceptions must come AFTER *test*)
!/tests/
!/tests/**
!/tests/**/*.vcf
!/tests/**/*.vcf.gz
!/tests/**/*.vcf.gz.tbi
!/tests/**/*.bed
!/tests/**/*.fa
!/tests/**/*.fa.fai
